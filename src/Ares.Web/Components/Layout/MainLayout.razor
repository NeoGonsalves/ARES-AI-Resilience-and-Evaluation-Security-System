@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="ARES overview">
            <span class="brand-mark" aria-hidden="true">A</span>
            <span>ARES</span>
        </a>
        <p class="brand-subtitle">Resilience system</p>

        <nav class="primary-nav">
            <NavLink href="/" Match="NavLinkMatch.All"><span aria-hidden="true">01</span> Overview</NavLink>
            <NavLink href="/arena"><span aria-hidden="true">02</span> ARES Arena</NavLink>
            <NavLink href="/attack-corpus"><span aria-hidden="true">03</span> Attack Corpus</NavLink>
            <NavLink href="/runtime-incidents"><span aria-hidden="true">04</span> Runtime Incidents</NavLink>
            <NavLink href="/prompt-configurations"><span aria-hidden="true">05</span> Prompt Configurations</NavLink>
            <NavLink href="/reports"><span aria-hidden="true">06</span> Reports</NavLink>
            <NavLink href="/settings"><span aria-hidden="true">07</span> Settings</NavLink>
        </nav>

        <div class="sidebar-status">
            <span class="status-dot operational" aria-hidden="true"></span>
            <span><strong>Systems nominal</strong><br /><small>6 services monitored</small></span>
        </div>
    </aside>

    <div class="shell-main">
        <header class="topbar">
            <div class="breadcrumb"><span>Security operations</span><span aria-hidden="true">/</span><strong>@PageTitle</strong></div>
            <div class="topbar-actions">
                <span class="environment"><span aria-hidden="true">●</span> Production mirror</span>
                <span class="profile" aria-label="Profile placeholder">NG</span>
            </div>
        </header>
        <main class="page-content">
            @Body
        </main>
    </div>
</div>

@code {
    private string PageTitle => NavigationManager.Uri.Contains("arena", StringComparison.OrdinalIgnoreCase) ? "ARES Arena" : "Overview";
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}
