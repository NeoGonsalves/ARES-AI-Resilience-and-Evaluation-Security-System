@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="ARES overview">
            <div class="mark" aria-hidden="true"><span>A</span></div>
            <div><h2>ARES</h2><p>Resilience system</p></div>
        </a>

        <nav class="primary-nav">
            <NavLink href="/" Match="NavLinkMatch.All"><b>Overview</b><i>Acropolis</i></NavLink>
            <NavLink href="/arena"><b>ARES Arena</b><i>Palaestra</i></NavLink>
            <NavLink href="/attack-corpus"><b>Attack Corpus</b><i>Armory</i></NavLink>
            <NavLink href="/runtime-incidents"><b>Runtime Incidents</b><i>Oracle</i></NavLink>
            <NavLink href="/prompt-configurations"><b>Prompt Configurations</b><i>Scrolls</i></NavLink>
            <NavLink href="/reports"><b>Reports</b><i>Chronicle</i></NavLink>
            <NavLink href="/settings"><b>Settings</b><i>Forge</i></NavLink>
        </nav>

        <div class="sidebar-status">
            <span class="status-dot operational" aria-hidden="true"></span>
            <span><strong>Systems nominal</strong><br /><small>6 services monitored</small></span>
        </div>
    </aside>

    <div class="shell-main">
        <header class="topbar">
            <div class="breadcrumb"><span>Security operations</span><span aria-hidden="true">/</span><strong>@PageTitle</strong></div>
            <div class="topbar-actions">
                <span class="environment"><span aria-hidden="true">●</span> Production mirror</span>
                <span class="profile" aria-label="Profile placeholder">NG</span>
            </div>
        </header>
        <main class="page-content">
            @Body
        </main>
    </div>
</div>

@code {
    private string PageTitle => NavigationManager.Uri.Contains("arena", StringComparison.OrdinalIgnoreCase) ? "ARES Arena" : "Overview";
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}
