@page "/"
@implements IDisposable
@inject IAresApiClient Api

<PageTitle>Overview · ARES</PageTitle>

@if (_loading)
{
    <LoadingState Message="Assembling the security overview…" />
}
else if (_error is not null)
{
    <ErrorState Title="Dashboard data is unavailable" Message="The overview could not be assembled. No protected-system state has been changed." Retry="LoadAsync" />
}
else if (_summary is not null)
{
    <section class="page-intro dashboard-intro">
        <div><p class="eyebrow">Security posture / 14-day view</p><h1>Control surface</h1><p>Protected applications, attack outcomes, and enforcement signals in one operational view.</p></div>
        <div class="intro-meta"><span>Last refreshed</span><strong>@_summary.GeneratedAt.ToString("dd MMM yyyy, HH:mm") IST</strong><button class="text-button" @onclick="LoadAsync">Refresh data</button></div>
    </section>

    @if (_summary.IsPartial)
    {
        <div class="inline-notice warning" role="status"><strong>Partial response.</strong> Some dashboard services did not respond; displayed data is current where available.</div>
    }

    <section aria-labelledby="summary-heading">
        <div class="section-heading"><div><p class="eyebrow">Executive security summary</p><h2 id="summary-heading">Current security posture</h2></div><p>Comparisons use the preceding 14-day period.</p></div>
        <div class="metric-grid">
            @foreach (var metric in _summary.Metrics) { <MetricSummary Metric="metric" /> }
        </div>
    </section>

    <section class="dashboard-two-col" aria-label="Security trends and attack analysis">
        <article class="surface-card trend-panel">
            <div class="section-heading compact"><div><p class="eyebrow">Security trend</p><h2>Tests and enforcement outcomes</h2></div><span class="subtle-code">14 DAYS</span></div>
            <TrendChart Data="_trends" />
        </article>
        <article class="surface-card category-panel">
            <div class="section-heading compact"><div><p class="eyebrow">Attack-category analysis</p><h2>Where controls are challenged</h2></div></div>
            <ul class="category-list">
                @foreach (var category in _categories)
                {
                    <li>
                        <div class="category-label"><span>@category.Category.ToLabel()</span><strong>@category.SuccessRate% success</strong></div>
                        <div class="category-bar" aria-label="@category.Category.ToLabel(): @category.SuccessRate percent successful"><span style="width: @category.SuccessRate%"></span></div>
                        <small>@category.Tests tests · @category.Blocked blocked · @category.Successful successful</small>
                    </li>
                }
            </ul>
        </article>
    </section>

    <section class="dashboard-two-col lower-grid" aria-label="Incidents and hardening">
        <article class="surface-card incidents-panel">
            <div class="section-heading compact"><div><p class="eyebrow">Recent critical incidents</p><h2>Requires analyst attention</h2></div><a class="text-button" href="/runtime-incidents">All incidents</a></div>
            @if (_incidents.Count == 0)
            {
                <EmptyState Eyebrow="No incidents" Title="No active incidents detected." Message="Runtime enforcement has not reported an incident during this period." />
            }
            else
            {
                <div class="history-table-wrap"><table class="data-table"><caption class="sr-only">Recent runtime incidents</caption><thead><tr><th scope="col">Incident</th><th scope="col">Application</th><th scope="col">Severity</th><th scope="col">Enforcement action</th><th scope="col">Status</th></tr></thead><tbody>
                    @foreach (var incident in _incidents.Take(5))
                    {
                        <tr><th scope="row">@incident.Id<small>@incident.Category.ToLabel() · @incident.DetectedAt.ToString("dd MMM, HH:mm")</small></th><td>@incident.Application</td><td><SeverityBadge Value="incident.Severity" /></td><td>@incident.EnforcementAction</td><td><span class="table-status">@incident.Status</span></td></tr>
                    }
                </tbody></table></div>
            }
        </article>
        <article class="surface-card hardening-panel">
            <div class="section-heading compact"><div><p class="eyebrow">Prompt-hardening comparison</p><h2>Measured control improvement</h2></div></div>
            <div class="hardening-rates"><div><span>Baseline success rate</span><strong>@_hardening.BaselineSuccessRate%</strong></div><span class="rate-arrow" aria-hidden="true">→</span><div><span>Hardened success rate</span><strong>@_hardening.HardenedSuccessRate%</strong></div></div>
            <div class="improvement-callout"><span>Absolute improvement</span><strong>@_hardening.ImprovementPoints pts</strong><p>Across @_hardening.TestsIncluded controlled tests. Last cycle: @_hardening.LastCycle.ToString("dd MMM yyyy").</p></div>
            <a class="button button-secondary" href="/arena">Review in ARES Arena</a>
        </article>
    </section>

    <section class="surface-card provider-panel" aria-labelledby="provider-heading">
        <div class="section-heading compact"><div><p class="eyebrow">Provider health</p><h2 id="provider-heading">Integration state</h2></div><span class="subtle-code">CHECKED @(_providers.FirstOrDefault()?.CheckedAt.ToString("HH:mm") ?? "—") IST</span></div>
        <ul class="provider-list">@foreach (var health in _providers) { <ProviderHealthRow Health="health" /> }</ul>
    </section>
}

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private DashboardSummary? _summary;
    private IReadOnlyList<TrendPoint> _trends = [];
    private IReadOnlyList<CategoryMetric> _categories = [];
    private IReadOnlyList<RuntimeIncident> _incidents = [];
    private IReadOnlyList<ProviderHealth> _providers = [];
    private HardeningComparison _hardening = new(0, 0, 0, 0, DateOnly.MinValue);
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            var summaryTask = Api.GetDashboardSummaryAsync(_cancellation.Token);
            var trendsTask = Api.GetDashboardTrendsAsync(_cancellation.Token);
            var categoriesTask = Api.GetCategoryMetricsAsync(_cancellation.Token);
            var incidentsTask = Api.GetRecentIncidentsAsync(_cancellation.Token);
            var hardeningTask = Api.GetHardeningComparisonAsync(_cancellation.Token);
            var providersTask = Api.GetProviderHealthAsync(_cancellation.Token);
            await Task.WhenAll(summaryTask, trendsTask, categoriesTask, incidentsTask, hardeningTask, providersTask);
            _summary = await summaryTask; _trends = await trendsTask; _categories = await categoriesTask;
            _incidents = await incidentsTask; _hardening = await hardeningTask; _providers = await providersTask;
        }
        catch (OperationCanceledException) { }
        catch { _error = "Unable to retrieve dashboard data from the ARES API."; }
        finally { _loading = false; }
    }

    public void Dispose() => _cancellation.Cancel();
}
